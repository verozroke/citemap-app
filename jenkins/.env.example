# Copy to .env and change the password. Docker Hub values are only needed for
# the optional "Push to Docker Hub" stage (create a token at hub.docker.com).
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
CITEMAP_REPO_URL=https://github.com/verozroke/citemap-app.git
